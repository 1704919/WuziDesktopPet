 7 | config/name="舞梓桌宠"
 8 | run/main_scene="res://scenes/main.tscn"
 9 | boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/minimum_display_time=0

[display]

window/size/viewport_width=760
window/size/viewport_height=420
window/size/window_width_override=760
window/size/window_height_override=420
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering/2d/snap/snap_2d_transforms_to_pixel=true
rendering/2d/snap/snap_2d_vertices_to_pixel=true
viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
